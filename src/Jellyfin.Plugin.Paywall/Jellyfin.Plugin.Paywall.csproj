<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.Paywall</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- ExcludeAssets=runtime: o servidor já carrega esses assemblies. Enviar cópias faz o
         mesmo tipo existir duas vezes e o plugin falha ao carregar. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Data" Version="10.11.11" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="10.11.11" ExcludeAssets="runtime" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Paywall.Infrastructure/Paywall.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration/configPage.html" />
    <EmbeddedResource Include="Configuration/configPage.html" />
    <None Remove="Web/portal.html" />
    <EmbeddedResource Include="Web/portal.html" />
  </ItemGroup>
</Project>
